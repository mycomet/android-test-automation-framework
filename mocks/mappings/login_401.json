{
    "request": {
        "method": "POST",
        "url": "/api/login",
        "bodyPatterns": [
            {
                "equalToJson": "{\"phone\":\"01012345678\",\"password\":\"wrong1234\"}"
            }
        ]
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": "application/json"
