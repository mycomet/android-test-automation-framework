{
    "request": {
        "method": "POST",
        "url": "/api/login",
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.phone == '01012345678' && @.password == 'test1234')]"
            }
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "resultType": "SUCCESS",
            "success": {
                "accessToken": "mock-access-token",
                "userId": "1001"
            }
        }
    }
}